# ── larpstore.app configuration ───────────────────────────────────────────
# Copy this file to ".env" and fill in the values. Never commit your real .env.

# Public URL of the site. Locally this is fine as-is. In production set it to
# your real domain, e.g. https://larpstore.app
BASE_URL=http://localhost:3000

# Port the server listens on.
PORT=3000

# development | production
NODE_ENV=development

# Long random string used to sign session cookies. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Send cookies only over HTTPS. Leave false for local http; set true in prod.
SECURE_COOKIES=false

# Where the SQLite database file lives (created automatically).
DB_PATH=./data/larpstore.db

# ── Google OAuth (Sign in with Google) ────────────────────────────────────
# Get these from https://console.cloud.google.com → APIs & Services →
# Credentials → Create OAuth client ID → Web application.
# Authorised redirect URI must be exactly:  <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults to <BASE_URL>/auth/google/callback
# GOOGLE_REDIRECT_URI=

# ── Payments (optional) ───────────────────────────────────────────────────
# Leave blank to run in DEMO checkout mode (purchases are recorded so the
# account + Library flow works, but no real money moves). To take real
# payments, add your Stripe keys and wire the handler — see README.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
